<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_light"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="0dp">

    <ImageView
        android:id="@+id/widget_source_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <LinearLayout
        android:id="@+id/widget_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/not_playing"
            android:textColor="#27232C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#716A76"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/previous"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_previous"
        android:tint="#27232C" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/play_pause"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play"
        android:tint="#FF6B5E" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/next"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_next"
        android:tint="#27232C" />
</LinearLayout>
